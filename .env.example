# Browser-safe Supabase values. Use the publishable key; never expose a secret/service_role key.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-local-publishable-key

# Server-only values are intentionally not required by the Phase 1 web app.
# SUPABASE_SERVICE_ROLE_KEY=
